{
  "name": "biblioteca-virtual",
  "version": "1.0.0",
  "description": "Gestión de catálogo de una biblioteca virtual - arquitectura en 3 capas",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.5.0"
  },
